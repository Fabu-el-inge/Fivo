# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
# For production, set comma-separated list of allowed origins
# Example: https://fivo.vercel.app,https://www.fivo.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
# Maximum requests per 15-minute window per IP
RATE_LIMIT_MAX=100
